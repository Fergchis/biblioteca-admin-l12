# Kafka (E3): el cluster que administran las rutas /v1/admin/kafka. En el equipo van estos tres puertos;
# en el compose, biblioteca-plataforma lo reemplaza por broker-1:19092,broker-2:19092,broker-3:19092, y en
# gestion (AWS) por las IP privadas de mq-1..3 en el 9092.
KAFKA_BROKERS=localhost:9092,localhost:9094,localhost:9096
